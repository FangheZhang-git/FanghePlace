# Include inside nginx's http context. Adapt domain/certificate paths first.
# This template assumes nginx is the only public proxy, directly facing clients.
limit_req_zone $binary_remote_addr zone=scholarmatch_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=scholarmatch_connections:10m;
server {
    listen 80;
    listen [::]:80;
    server_name scholarmatch.net www.scholarmatch.net;
    return 301 https://scholarmatch.net$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name scholarmatch.net www.scholarmatch.net;
    ssl_certificate /etc/letsencrypt/live/scholarmatch.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scholarmatch.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 50k;
    client_header_timeout 10s;
    client_body_timeout 15s;
    limit_req_status 429;
    limit_conn_status 429;
    location / {
        limit_req zone=scholarmatch_requests burst=60 nodelay;
        limit_conn scholarmatch_connections 30;
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        # Overwrite client-supplied forwarding headers, do not append them.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }
}
