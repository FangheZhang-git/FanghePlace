DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=3001
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:8080

# Bind locally behind an HTTPS reverse proxy. Containers may need HOST=0.0.0.0
# with private container networking and no public application-port mapping.
HOST=127.0.0.1
NODE_ENV=development
# Set only when a trusted reverse proxy is installed (e.g. loopback for local nginx).
TRUSTED_PROXIES=
# Required in production. Use a random JWT_SECRET of at least 32 bytes.
# Create a Turnstile widget for your domain; never commit the secret key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=

# Railway HTTP edge only, with NO public app TCP proxy: set to 1 after checking ingress.
# Leave TRUSTED_PROXIES empty when using hop count. Local development: leave empty.
TRUSTED_PROXY_HOPS=
